# Ignore system-specific files
.DS_Store
Thumbs.db

# Ignore local configuration files
*.env

# Ignore SQL Server-related files
*.mdf
*.ldf
*.ndf

# Ignore temporary or backup files
*.log
*.bak
*.tmp

# Ignore IDE-specific files
.vscode/
.idea/

# Ignore exported data or diagrams (if applicable)
*.csv
*.png
*.pdf

# Ignore graphify generated knowledge graph
graphify-out/

# Ignore Python build/venv artefacts (8 stale .pyc files were committed before
# these were listed; .dockerignore already had the equivalent rules)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Ignore Node build output
node_modules/
dist/
