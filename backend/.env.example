# Copy to .env and fill in. Required: the app has no default credential and
# refuses to connect without DWH_PASSWORD.
DWH_DIALECT=postgres
DWH_HOST=localhost
DWH_PORT=5433
DWH_DATABASE=datawarehouse
DWH_USER=postgres
DWH_PASSWORD=DwhDev2026

# Optional. Seconds before a connection attempt is abandoned; without it a dead
# host blocks a worker thread indefinitely.
DWH_TIMEOUT=10

# Optional. Comma-separated CORS allowlist. Defaults to * (public read-only
# dashboard). Set it to the deployed frontend origin to narrow it.
DWH_CORS_ORIGINS=*
